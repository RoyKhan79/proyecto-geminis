{
  "name": "geminis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "./scripts/dev-db.sh start",
    "db:stop": "./scripts/dev-db.sh stop",
    "db:reset": "./scripts/dev-db.sh reset",
    "db:sql": "node scripts/db-sql.mjs query",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup": "npm install && ./scripts/dev-db.sh start && prisma migrate deploy && prisma generate && prisma db seed",
    "demo:contenido": "node --env-file=.env --import tsx scripts/demo-content.ts",
    "demo:preguntas": "node --env-file=.env --import tsx scripts/demo-questions.ts",
    "demo:todo": "npm run db:seed && npm run demo:contenido && npm run demo:preguntas && npm run demo:normativa",
    "radar": "node --env-file=.env --import tsx scripts/radar.ts",
    "demo:normativa": "node --env-file=.env --import tsx scripts/demo-legislation.ts",
    "ia:probar": "node --env-file=.env --import tsx scripts/probar-ia.ts",
    "indexar": "node --env-file=.env --import tsx scripts/indexar.ts",
    "iconos": "node --import tsx scripts/iconos.ts",
    "mantenimiento": "node --env-file=.env --import tsx scripts/mantenimiento.ts",
    "auditoria": "node scripts/auditoria-interna.mjs && node scripts/auditoria.mjs",
    "auditoria:interna": "node scripts/auditoria-interna.mjs",
    "auditoria:http": "node scripts/auditoria.mjs",
    "verificar": "npm run lint && npm run typecheck && npm test && npm run build",
    "rls:probar": "node --env-file=.env --import tsx scripts/probar-rls.ts",
    "rls:medir": "node --env-file=.env --import tsx scripts/medir-rls.ts",
    "remesa:probar": "node --env-file=.env --import tsx scripts/probar-remesa.ts",
    "superadmin": "node --env-file=.env --import tsx scripts/superadmin.ts",
    "rls:concurrencia": "node --env-file=.env --import tsx scripts/probar-concurrencia.ts",
    "facturas:probar": "node --env-file=.env --import tsx scripts/probar-facturas.ts",
    "cifrar:migrar": "node --env-file=.env --import tsx scripts/cifrar-existentes.ts",
    "dispositivos:probar": "node --env-file=.env --import tsx scripts/probar-dispositivos.ts",
    "copia": "node --env-file=.env --import tsx scripts/copia-seguridad.ts",
    "copia:restaurar": "node --env-file=.env --import tsx scripts/restaurar-copia.ts",
    "ia:fuga": "node --env-file=.env --import tsx scripts/probar-fuga-ia.ts",
    "pentest": "node scripts/pentest.mjs",
    "desplegar:comprobar": "node --env-file=.env --import tsx scripts/comprobar-despliegue.ts",
    "manual:capturas": "node --import tsx scripts/capturas.ts",
    "manual:local": "node --import tsx scripts/manual-local.ts",
    "docs": "typedoc",
    "docs:faltan": "node scripts/docs-faltan.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
