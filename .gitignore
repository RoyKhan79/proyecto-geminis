# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Geminis
/.dev/
/src/generated/
.env
.env*.local

# El manual en un solo archivo. Se genera con `npm run manual:local` a partir
# de /manual, así que guardarlo aquí sería tener dos manuales que se
# contradicen, y ocho megas de fotos duplicadas en el histórico.
/Manual de Geminis.html

# La referencia del código generada con `npm run docs`. Son miles de archivos
# y se rehace en segundos: lo que se versiona son los comentarios del código.
/docs/api/
