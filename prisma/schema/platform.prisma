// ─────────────────────────────────────────────────────────────────────────────
// PLATAFORMA · La academia es el tenant
//
// Decisión ADR-0002: en Geminis `Academy` ES el tenant. No existe una tabla
// `Tenant` separada porque hoy sería una indirección sin uso. Si en el futuro
// aparecen grupos con varias academias, se añade `Organization` POR ENCIMA de
// Academy, que es una migración aditiva y sencilla.
// ─────────────────────────────────────────────────────────────────────────────

enum AcademyStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PlanCode {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

/// Plan comercial de la plataforma. Los límites viven en columnas explícitas
/// (no en un JSON opaco) para poder consultarlos y compararlos en SQL.
model Plan {
  id   String   @id @default(uuid(7))
  code PlanCode @unique
  name String

  priceCents    Int    @default(0)
  currency      String @default("EUR")
  billingPeriod String @default("MONTHLY") // MONTHLY | YEARLY

  maxStudents      Int? // null = sin límite
  maxTeachers      Int?
  maxAdmins        Int?
  maxOppositions   Int?
  storageGb        Int?
  aiTokensPerMonth Int?

  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academies Academy[]

  @@map("plans")
}

/// Una academia = un tenant = una frontera de aislamiento total.
model Academy {
  id   String @id @default(uuid(7))
  /// Identificador legible usado en URLs y subdominios. Inmutable en la práctica.
  slug String @unique
  name String

  legalName String?
  taxId     String?
  email     String?
  phone     String?
  address   String?
  city      String?
  province  String?
  country   String  @default("ES")

  status      AcademyStatus @default(TRIAL)
  trialEndsAt DateTime?
  planId      String?
  plan        Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  locale   String @default("es-ES")
  timezone String @default("Europe/Madrid")

  /// Cuántas sesiones simultáneas se permiten por alumno.
  ///
  /// Compartir la cuenta es la primera fuga de ingresos de una academia: uno
  /// paga y estudian cuatro. Con un límite, la cuarta sesión echa a la primera,
  /// y el titular nota que le echan. Cero significa sin límite.
  maxSessionsPerStudent Int @default(2)

  // White-label (§60). Personalización ligera desde el día uno; dominio propio
  // queda modelado pero sin resolución activa hasta la fase correspondiente.
  logoUrl      String?
  primaryColor String? @default("#2956c4")
  customDomain String? @unique

  // ── Datos para domiciliar recibos ──────────────────────────────────────────
  // Solo hacen falta si la academia cobra por domiciliación. Los tres van
  // juntos: sin cualquiera de ellos, el banco rechaza el fichero.
  /// Cuenta de la academia donde se ingresan los recibos.
  billingIban String?
  /// Identificador de acreedor SEPA. Lo da el banco al firmar el contrato de
  /// adeudos. En España empieza por ES.
  creditorId  String?
  /// Prefijo para las referencias de mandato. Debe ser estable en el tiempo.
  mandatePrefix String?

  /// Ajustes de producto por academia (marcas de agua, descargas por defecto,
  /// política de IA…). JSON porque son banderas heterogéneas y cambiantes.
  settings Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships       Membership[]
  roles             Role[]
  oppositionTypes   OppositionType[]
  oppositions       Opposition[]
  oppositionEdition OppositionEdition[]
  courses           Course[]
  groups            Group[]
  enrollments       Enrollment[]
  teacherAssignment TeacherAssignment[]
  contentNodes      ContentNode[]
  contentReleases   ContentRelease[]
  storedFiles       StoredFile[]
  contentProgress   StudentContentProgress[]
  classSessions     ClassSession[]
  classAttendances  ClassAttendance[]
  questions         Question[]
  questionOptions   QuestionOption[]
  examBlueprints    ExamBlueprint[]
  testDefinitions   TestDefinition[]
  testAttempts      TestAttempt[]
  testAttemptAnswer TestAttemptAnswer[]
  questionStats     StudentQuestionStat[]
  products          Product[]
  productGrants     ProductGrant[]
  entitlements      Entitlement[]
  payments          Payment[]
  billingProfiles   BillingProfile[]
  recurringCharges  RecurringCharge[]
  directDebitRuns   DirectDebitRun[]
  invoiceSeries     InvoiceSeries[]
  invoices          Invoice[]
  invoiceLines      InvoiceLine[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  importJobs        ImportJob[]
  importRows        ImportRow[]
  knowledgeSources  KnowledgeSource[]
  documentChunks    DocumentChunk[]
  aiConversations   AIConversation[]
  aiMessages        AIMessage[]
  aiUsages          AIUsage[]
  legislations      Legislation[]
  legislationVers   LegislationVersion[]
  legislationArts   LegislationArticle[]
  contentLegLinks   ContentLegislationLink[]
  legislationAlerts LegislationChangeAlert[]
  oppositionWatches OppositionWatch[]
  officialCalls     OfficialCall[]
  wallPosts         WallPost[]
  wallComments      WallComment[]
  messageThreads    MessageThread[]
  messages          Message[]
  assignments       Assignment[]
  submissions       Submission[]
  submissionFiles   SubmissionFile[]
  liveRooms         LiveRoom[]
  sessions          Session[]
  modules           AcademyModule[]

  @@index([status])
  @@map("academies")
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULOS CONTRATADOS
//
// Una academia no compra «Geminis»: compra las partes que necesita. La que solo
// da clases presenciales no quiere pagar por la app del alumnado; la que ya
// tiene gestoría no necesita la facturación.
//
// El catálogo con los precios de referencia vive en `src/lib/modules/catalogo.ts`,
// versionado. Aquí se guarda lo que cada academia tiene contratado **y a qué
// precio**, que no tiene por qué ser el de catálogo: los precios se negocian, y
// un sistema que no lo admita obliga a mentir en algún sitio.
//
// Decisión: no hay tabla de catálogo en la base. El catálogo es código porque
// cambia con el producto —un módulo nuevo llega con las pantallas que lo
// justifican— y tenerlo en dos sitios acabaría con los dos discrepando.
// ─────────────────────────────────────────────────────────────────────────────

enum ModuleCode {
  NUCLEO
  CONTENIDO
  EVALUACION
  TAREAS
  AGENDA
  COBROS
  FACTURACION
  COMUNICACION
  CAMPUS
  IA
  ANALITICA
  NORMATIVA
}

model AcademyModule {
  id        String  @id @default(uuid(7))
  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  module ModuleCode

  /// Está activo ahora mismo. Se desactiva en lugar de borrarse: qué tuvo
  /// contratado una academia y hasta cuándo es justo lo que hay que poder
  /// consultar cuando alguien discute una factura.
  active Boolean @default(true)

  /// Lo que paga ESTA academia al mes por este módulo, en céntimos. Si es null,
  /// se cobra el precio de catálogo.
  priceCents Int?

  activatedAt   DateTime  @default(now())
  deactivatedAt DateTime?

  /// Por qué se pactó ese precio, o por qué se quitó. Lo escribe quien lo hace.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academyId, module])
  @@index([academyId, active])
  @@map("academy_modules")
}
