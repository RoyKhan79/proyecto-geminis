# ─────────────────────────────────────────────────────────────────────────────
# GEMINIS · variables de entorno
# Copia este archivo a `.env` y ajusta lo que necesites.
# `.env` está ignorado por git y NUNCA debe subirse al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos. En desarrollo la levanta `npm run db:start` (PostgreSQL local,
# sin Docker). En producción, cualquier PostgreSQL 15+.
# La aplicación se conecta con un rol SIN superusuario y SIN BYPASSRLS: es lo
# que hace que Row Level Security proteja de verdad (ver docs/SECURITY_MODEL.md).
DATABASE_URL="postgresql://geminis_app:geminis_app@127.0.0.1:55432/geminis?schema=public"

# El dueño de las tablas. Solo migraciones y semillas.
DATABASE_URL_OWNER="postgresql://geminis:geminis@127.0.0.1:55432/geminis?schema=public"

# Base de datos de sombra para `prisma migrate dev` (opcional en local).
# SHADOW_DATABASE_URL=""

# Secreto de sesión. OBLIGATORIO cambiarlo en producción.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"

# Días que dura una sesión antes de caducar.
SESSION_DAYS=30

# URL pública de la aplicación.
APP_URL="http://localhost:3000"

# ── Almacenamiento de archivos ───────────────────────────────────────────────
# local = disco (solo desarrollo) · s3 = cualquier almacén compatible con S3.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".dev/storage"
# S3_ENDPOINT=""
# S3_REGION="eu-west-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Correo saliente ──────────────────────────────────────────────────────────
# Sin configurar, en desarrollo los correos se escriben en .dev/emails/ en vez
# de enviarse. Así se pueden probar avisos y radares sin molestar a nadie.
# SMTP_HOST="smtp.tuproveedor.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Proyecto Geminis <avisos@tudominio.com>"

# ── Geminis IA ───────────────────────────────────────────────────────────────
# La aplicación nunca llama a un proveedor directamente: todo pasa por el
# Gateway de IA (docs/AI_ARCHITECTURE.md), que es quien decide proveedor,
# modelo, límites y registro de consumo.
AI_PROVIDER="none"          # none | anthropic | openai
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Cifrado de campos sensibles (IBAN). Obligatoria en producción.
#   openssl rand -base64 48
FIELD_ENCRYPTION_KEY=""

# La clave ANTERIOR, solo mientras dura una rotacion. Se descifra probando
# primero la actual y despues esta; se cifra siempre con la actual, asi que la
# clave se puede cambiar sin parar el servicio y sin que nada quede ilegible:
#
#   1. mueve la clave actual aqui y pon una nueva arriba
#   2. despliega
#   3. npm run cifrar:rotar
#   4. quita esta variable y vuelve a desplegar
#
# Dejarla puesta para siempre no rompe nada, pero mantiene viva una clave que a
# lo mejor se roto justamente porque se habia visto.
# FIELD_ENCRYPTION_KEY_ANTERIOR=""

# El superadministrador de la plataforma.
#
# Van aqui y NO en prisma/seed.ts, que es donde estaban: un valor por defecto
# en un archivo versionado no es un valor por defecto, es una credencial
# publica. Sin estas variables la semilla no crea superadministrador y lo dice;
# se puede crear despues con `npm run superadmin -- <correo>`.
#
# Los scripts de auditoria y el pentest tambien las leen de aqui para poder
# comprobar que el superadmin NO entra en los datos de ninguna academia.
# SUPERADMIN_EMAIL=""
# SUPERADMIN_PASSWORD=""
